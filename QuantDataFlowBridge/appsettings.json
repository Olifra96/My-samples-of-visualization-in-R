{
  // Endpunkte, Auth (Bearer), POST+JSON, data/nextSearchAfter/searchAfter laut QuantData-Beschreibung.
  "Api": {
    "BaseUrl": "https://api.quantdata.us/",
    "ConsolidatedPath": "v1/options/tool/order-flow/consolidated",
    "UnconsolidatedPath": "v1/options/tool/order-flow/unconsolidated",
    "UnconsolidatedRemoveKeys": [ "includeComprisingTrades" ],
    "DataArrayProperty": "data",
    "NextCursorProperty": "nextSearchAfter",
    "CursorRequestProperty": "searchAfter",

    "PageSize": 100,
    "MaxCatchUpPages": 8,
    "OverlapSeconds": 30,
    "MaxLookbackHours": 24,
    "PollSeconds": 10,
    "FallbackMinutes": 5,
    "DefaultRetryAfterSeconds": 30,

    // ACHTUNG – UNBESTÄTIGT: Die genaue Form von timeRange, Ticker-Filter, Sortierung und Seitengröße
    // muss aus app/api/flow/route.ts bzw. der QuantData-Doku übernommen werden.
    // Platzhalter: $ticker $fromMs $toMs $fromIso $toIso $pageSize $sortDirection
    "SortAscValue": "ASC",
    "SortDescValue": "DESC",
    "RequestBodyTemplate": {
      "timeRange": { "from": "$fromMs", "to": "$toMs" },
      "filter": { "ticker": "$ticker" },
      "sort": { "field": "tradeTime", "direction": "$sortDirection" },
      "size": "$pageSize",
      "includeComprisingTrades": true
    }
  },

  // Bestätigt laut Beschreibung: tradeTime, tradeSideCode, tradeType, tradeConsolidationType,
  // isGoldenSweep, comprisingTrades, premium, size. Alle übrigen Namen sind UNBESTÄTIGT (aus lib/flow.ts prüfen).
  "FieldMap": {
    "Id": "id",
    "TradeTime": "tradeTime",
    "Ticker": "ticker",
    "Osi": "osi",
    "PutCall": "putCall",
    "Expiration": "expirationDate",
    "Dte": "dte",
    "Strike": "strike",
    "Premium": "premium",
    "Size": "size",
    "Volume": "volume",
    "OpenInterest": "openInterest",
    "Price": "price",
    "UnderlyingPrice": "underlyingPrice",
    "TradeSideCode": "tradeSideCode",
    "TradeType": "tradeType",
    "TradeConsolidationType": "tradeConsolidationType",
    "Sentiment": "sentiment",
    "IsGoldenSweep": "isGoldenSweep",
    "ComprisingTrades": "comprisingTrades"
  },

  "Filter": {
    "Tickers": [ "SPX" ],
    "OptionalTickers": [ ],
    "MinPremium": 0
  },

  // tradeSideCode -> Aggressor (Reader-Ableitung). Leer = alles UNKNOWN, bis die echten Codes
  // aus der QuantData-Doku bzw. der bestehenden Reader-Logik eingetragen sind. Beispielform:
  //   "<Code oberhalb Ask>": { "Aggressor": "BUY",  "Confidence": "HIGH" },
  //   "<Code unterhalb Bid>": { "Aggressor": "SELL", "Confidence": "HIGH" }
  "Reader": {
    "TradeSideCodeMap": { }
  },

  "Output": {
    "Directory": "C:\\QuantDataFlow",
    "WriteCsv": true,
    "WriteJson": true,
    "JsonMaxRecords": 500,
    "StoreMaxRecords": 20000,
    "HttpPort": 5005
  }
}
