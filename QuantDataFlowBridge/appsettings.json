{
  "Api": {
    "BaseUrl": "https://api.quantdata.us/",
    "FlowPath": "v1/options/flow",
    "TickerQueryParam": "ticker",
    "ApiKeyHeader": "Authorization",
    "ApiKeyPrefix": "Bearer ",
    "DataArrayProperty": "data",
    "PollSeconds": 15
  },

  "FieldMap": {
    "Id": "id",
    "Time": "timestamp",
    "Ticker": "ticker",
    "Expiry": "expiration",
    "Strike": "strike",
    "PutCall": "put_call",
    "Side": "side",
    "Size": "size",
    "Price": "price",
    "Premium": "premium",
    "Underlying": "underlying_price"
  },

  "Filter": {
    "Tickers": [ "SPY", "QQQ" ],
    "MinPremium": 100000
  },

  "Output": {
    "Directory": "C:\\QuantDataFlow",
    "WriteCsv": true,
    "WriteJson": true,
    "JsonMaxRecords": 500,
    "HttpPort": 5005
  }
}
